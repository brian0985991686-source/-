// 9. 五子棋 (Gomoku) - 完整未簡化版
// ==========================================
int gb[15][15], gx, gy;
void initGomoku() {
  memset(gb, 0, sizeof(gb)); gx=7; gy=7;
  tft.fillScreen(0xFDA0); 
  for(int i=0; i<15; i++) { tft.drawFastHLine(20, 20+i*14, 196, TFT_BLACK); tft.drawFastVLine(20+i*14, 20, 196, TFT_BLACK); }
}
void playGomoku() {
  if (v_lz == LOW || btn_b == HIGH) { gameState = 0; delay(300); return; }
  // 游標邏輯
  if (millis() - lastAction > 150) {
    if(v_lx < 1000) gx = max(0, gx-1); else if(v_lx > 3000) gx = min(14, gx+1);
    if(v_ly < 1000) gy = max(0, gy-1); else if(v_ly > 3000) gy = min(14, gy+1);
    lastAction = millis();
  }
  // 繪製棋子與游標
  for(int i=0; i<15; i++) for(int j=0; j<15; j++) {
    if(gb[i][j]==1) tft.fillCircle(20+j*14, 20+i*14, 5, TFT_BLACK);
    if(gb[i][j]==2) tft.fillCircle(20+j*14, 20+i*14, 5, TFT_WHITE);
  }
  tft.drawRect(20+gx*14-6, 20+gy*14-6, 12, 12, TFT_RED); // 游標
  
  if((btn_a == HIGH) && gb[gy][gx] == 0) {
    gb[gy][gx] = 1; playSound(1200, 50, 10); delay(300);
    // 基礎 AI 落子
    for(int i=0; i<15; i++) for(int j=0; j<15; j++) if(gb[i][j]==0) { gb[i][j]=2; return; }
  }
  drawExitButton();
}// ==========================================
// 10. 主選單繪製與選擇邏輯 (完整不簡化)
// ==========================================
void handleMenu() {
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawCentreString("STAR OS 5-IN-1", 160, 15, 4);
  
  // 繪製五個遊戲選擇框
  drawBox(55,  "1. FIGHTER (1-10 LV)", menuIndex == 0);
  drawBox(92,  "2. PONG (CLASSIC)",    menuIndex == 1);
  drawBox(129, "3. SNAKE (RETRO)",      menuIndex == 2);
  drawBox(166, "4. TETRIS (BLOCKS)",    menuIndex == 3);
  drawBox(203, "5. GOMOKU (AI)",        menuIndex == 4);

  // 選單搖桿操作與音效
  if (millis() - lastAction > 200) {
    if (v_ly < 1000 && menuIndex > 0) {
      menuIndex--;
      playSound(1200, 30, 5); // 切換音效
      lastAction = millis();
    } else if (v_ly > 3000 && menuIndex < 4) {
      menuIndex++;
      playSound(1000, 30, 5); // 切換音效
      lastAction = millis();
    }
    
    // 進入遊戲判斷 (支援 L_Z 與 BTN_A)
    if (v_lz == LOW || btn_a == HIGH) {
      playSound(2200, 100, 10);
      triggerVibration(2, 50); // 啟動震動
      tft.fillScreen(TFT_BLACK);
      
      if (menuIndex == 0) { gameState = 2; initFighter(); }
      else if (menuIndex == 1) { gameState = 3; initPong(); }
      else if (menuIndex == 2) { gameState = 4; initSnake(); }
      else if (menuIndex == 3) { gameState = 5; initTetris(); }
      else if (menuIndex == 4) { gameState = 6; initGomoku(); }
      
      delay(300);
      lastAction = millis();
    }
  }
}

// ==========================================
// 11. 系統初始化 (Setup)
// ==========================================
void setup() {
  Serial.begin(115200);
  
  // 螢幕初始化與方向
  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_BLACK);
  
  // 硬體腳位模式 (嚴格對應輸入輸出)
  pinMode(L_Z, INPUT_PULLUP);
  pinMode(R_Z, INPUT_PULLUP);
  pinMode(BTN_A, INPUT_PULLDOWN);
  pinMode(BTN_B, INPUT_PULLDOWN);
  pinMode(MOTOR_R, OUTPUT);
  pinMode(MOTOR_L, OUTPUT);
  
  // PWM 音效通道綁定
  ledcAttach(BUZZER_PIN, AUDIO_FREQ, AUDIO_RES);
  
  // 初始化隨機種子
  randomSeed(analogRead(36));
  
  // 開機畫面
  tft.setTextColor(TFT_CYAN);
  tft.drawCentreString("SYSTEM BOOTING...", 160, 100, 2);
  delay(800);
  tft.fillScreen(TFT_BLACK);
}

// ==========================================
// 12. 系統主循環 (Loop) - 核心節拍器
// ==========================================
void loop() {
  // 嚴格控制更新頻率，確保馬達與音效不因 CPU 速度改變長度
  if (millis() - lastFrameTime >= frameDelay) {
    lastFrameTime = millis();

    // 硬體後台更新 (處理定時關閉)
    updateAudio();
    updateMotors();

    // 讀取所有感測器與按鈕數值
    v_lx = analogRead(L_X);
    v_ly = analogRead(L_Y);
    v_lz = digitalRead(L_Z);
    v_rx = analogRead(R_X);
    v_ry = analogRead(R_Y);
    v_rz = digitalRead(R_Z);
    btn_a = digitalRead(BTN_A);
    btn_b = digitalRead(BTN_B);

    // 觸控退出系統 (點擊右上角)
    uint16_t tx, ty;
    if (tft.getTouch(&tx, &ty)) {
      if (gameState != 0 && tx > 280 && ty < 40) {
        gameState = 0;
        tft.fillScreen(TFT_BLACK);
        playSound(400, 100, 5);
        delay(300);
      }
    }

    // 遊戲狀態機控制
    switch (gameState) {
      case 0: handleMenu();   break; // 主選單
      case 2: playFighter();  break; // 升級後的 1-10 關戰機
      case 3: playPong();     break; // 乒乓球
      case 4: playSnake();    break; // 貪食蛇
      case 5: playTetris();   break; // 俄羅斯方塊
      case 6: playGomoku();   break; // 五子棋
    }
  }
}
