// 7. 貪食蛇 (Snake) - 完整未簡化版
// ==========================================
int snakeX[100], snakeY[100], snakeLen, sDir, foodX, foodY;
unsigned long lastSnakeMove = 0;

void initSnake() {
  snakeLen = 3; sDir = 1; 
  for(int i=0; i<3; i++) { snakeX[i] = 10-i; snakeY[i] = 10; }
  foodX = random(2, 30); foodY = random(2, 22);
  tft.fillScreen(TFT_BLACK);
}

void playSnake() {
  if (v_lz == LOW || btn_b == HIGH) { gameState = 0; delay(300); return; }
  if (v_ly < 1000 && sDir != 2) sDir = 0;
  else if (v_lx > 3000 && sDir != 3) sDir = 1;
  else if (v_ly > 3000 && sDir != 0) sDir = 2;
  else if (v_lx < 1000 && sDir != 1) sDir = 3;

  if (millis() - lastSnakeMove > 150) {
    tft.fillRect(snakeX[snakeLen-1]*10, snakeY[snakeLen-1]*10, 9, 9, TFT_BLACK);
    for(int i=snakeLen-1; i>0; i--) { snakeX[i] = snakeX[i-1]; snakeY[i] = snakeY[i-1]; }
    
    if(sDir==0) snakeY[0]--; else if(sDir==1) snakeX[0]++; 
    else if(sDir==2) snakeY[0]++; else if(sDir==3) snakeX[0]--;
    
    // 吃食物判定
    if(snakeX[0] == foodX && snakeY[0] == foodY) {
      snakeLen++; foodX = random(2, 30); foodY = random(2, 22);
      playSound(2000, 50, 15); triggerVibration(2, 60);
    }
    
    // 繪製
    for(int i=0; i<snakeLen; i++) tft.fillRect(snakeX[i]*10, snakeY[i]*10, 9, 9, (i==0)?TFT_GREEN:0x03E0);
    tft.fillRect(foodX*10, foodY*10, 9, 9, TFT_RED);
    
    // 死亡判定
    if(snakeX[0]<0 || snakeX[0]>31 || snakeY[0]<0 || snakeY[0]>23) {
      playSound(150, 500, 15); triggerVibration(2, 500);
      initSnake();
    }
    lastSnakeMove = millis();
  }
  drawExitButton();
}

