// 8. 俄羅斯方塊 (Tetris) - 完整未簡化版
// ==========================================
uint8_t grid[20][10];
int curPiece, curRot, curX, curY;
unsigned long lastFall = 0;
const uint16_t tetColors[] = {TFT_BLACK, TFT_CYAN, TFT_YELLOW, 0x801F, TFT_GREEN, TFT_RED, TFT_BLUE, 0xFD20};
const uint16_t shapes[7][4] = {
  {0x0F00,0x2222,0x00F0,0x4444}, {0x0660,0x0660,0x0660,0x0660}, {0x0E40,0x4C40,0x4E00,0x8C80},
  {0x06C0,0x8C40,0x06C0,0x8C40}, {0x0C60,0x4C80,0x0C60,0x4C80}, {0x0E80,0xC440,0x2E00,0x88C0},
  {0x0E20,0x44C0,0x8E00,0xC880}
};

void initTetris() { memset(grid, 0, sizeof(grid)); tft.fillScreen(TFT_BLACK); spawnPiece(); }
void spawnPiece() { curPiece = random(0,7); curRot = 0; curX = 3; curY = 0; }

bool checkCollision(int nx, int ny, int nr) {
  for(int i=0; i<4; i++) for(int j=0; j<4; j++) {
    if((shapes[curPiece][nr] >> (15-(i*4+j))) & 1) {
      int px = nx + j, py = ny + i;
      if(px<0 || px>=10 || py>=20 || (py>=0 && grid[py][px])) return true;
    }
  }
  return false;
}

void playTetris() {
  if (v_lz == LOW || btn_b == HIGH) { gameState = 0; delay(300); return; }
  
  if (v_lx < 1000 && !checkCollision(curX-1, curY, curRot)) { curX--; delay(100); }
  if (v_lx > 3000 && !checkCollision(curX+1, curY, curRot)) { curX++; delay(100); }
  if (v_ly > 3000 && !checkCollision(curX, curY+1, curRot)) { curY++; delay(50); }
  if (v_ry < 1000) { 
    int nextR = (curRot+1)%4; 
    if(!checkCollision(curX, curY, nextR)) { curRot = nextR; playSound(1500, 20, 5); } 
    delay(200); 
  }

  if (millis() - lastFall > 600) {
    if(!checkCollision(curX, curY+1, curRot)) curY++;
    else {
      for(int i=0; i<4; i++) for(int j=0; j<4; j++) 
        if((shapes[curPiece][curRot]>>(15-(i*4+j)))&1) grid[curY+i][curX+j] = curPiece+1;
      
      // 消行與音效震動
      for(int i=0; i<20; i++) { 
        bool full=true; for(int j=0; j<10; j++) if(!grid[i][j]) full=false; 
        if(full) { 
          for(int k=i; k>0; k--) memcpy(grid[k], grid[k-1], 10); memset(grid[0],0,10); 
          playSound(800, 150, 15); triggerVibration(2, 100); 
        } 
      }
      spawnPiece(); if(checkCollision(curX, curY, curRot)) initTetris();
    }
    lastFall = millis();
  }
  
  // 繪製網格
  for(int i=0; i<20; i++) for(int j=0; j<10; j++) 
    tft.fillRect(110+j*11, i*12, 10, 11, tetColors[grid[i][j]]);
  // 繪製當前方塊
  for(int i=0; i<4; i++) for(int j=0; j<4; j++) 
    if((shapes[curPiece][curRot]>>(15-(i*4+j)))&1) tft.fillRect(110+(curX+j)*11, (curY+i)*12, 10, 11, tetColors[curPiece+1]);
  
  drawExitButton();
}

