// 原始 playSound: 支援頻率、持續時間與音量
void playSound(int freq, int dur, int vol) {
  ledcWriteTone(BUZZER_PIN, freq);
  audioEndTime = millis() + dur;
}

// 原始更新函式: 確保時間到自動關閉，不阻塞主程式
void updateAudio() { 
  if (millis() > audioEndTime) ledcWriteTone(BUZZER_PIN, 0); 
}

// 原始震動控制: 支援左右馬達獨立或同時驅動
void triggerVibration(int mode, int dur) {
  if (mode == 0 || mode == 2) motorEndTimeL = millis() + dur;
  if (mode == 1 || mode == 2) motorEndTimeR = millis() + dur;
}

// 原始馬達更新: 物理層面驅動 GPIO
void updateMotors() {
  digitalWrite(MOTOR_L, (millis() < motorEndTimeL) ? HIGH : LOW);
  digitalWrite(MOTOR_R, (millis() < motorEndTimeR) ? HIGH : LOW);
}

