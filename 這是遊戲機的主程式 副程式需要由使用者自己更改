void initFighter() {
  p = {160, 200}; pvx = 0; pvy = 0; fighterScore = 0; nextBossScore = 40;
  gameLevel = 1; playerHp = 5; playerStatus = 0; statusTimer = 0;
  for(int i=0; i<50; i++) bullets[i].active = false;
  for(int i=0; i<80; i++) bossBullets[i].active = false;
  for(int i=0; i<8; i++) enemies[i].active = false;
  boss.active = false; tft.fillScreen(TFT_BLACK);
}

// 帶有完整音效與馬達回饋的受傷函式
void takeDamage(int dmg, int statusType = 0) {
  if (millis() < invincibleTime) return;
  playerHp -= dmg;
  
  if (statusType > 0) {
    playerStatus = statusType;
    statusTimer = millis() + 3000; 
    // 負面狀態專用音效與震動
    if(statusType == 1) { playSound(400, 400, 15); triggerVibration(2, 400); } // 減速：低重音
    else if(statusType == 2) { playSound(1800, 100, 12); delay(20); playSound(1200, 100, 12); triggerVibration(0, 300); } // 反轉：錯亂音
    else if(statusType == 3) { playSound(5000, 80, 20); triggerVibration(1, 500); } // 禁射：尖銳電子音
  } else {
    playSound(150, 200, 15); // 普通受傷：低沉爆炸音
    triggerVibration(2, 250); 
  }
  invincibleTime = millis() + 1200;
}

void firePlayerBullet(float x, float y, float vx, float vy) {
  for(int i=0; i<50; i++) {
    if(!bullets[i].active) { bullets[i] = {x, y, vx, vy, true, 0}; break; }
  }
}

void fireBossBullet(float x, float y, float vx, float vy, int type = 0) {
  for(int i=0; i<80; i++) {
    if(!bossBullets[i].active) { bossBullets[i] = {x, y, vx, vy, true, type}; break; }
  }
}

void playFighter() {
  // 雙搖桿按下退出
  if (v_lz == LOW && v_rz == LOW) { gameState = 0; delay(400); return; }

  // --- 1. 負面狀態物理處理 ---
  float mSpeed = 1.0; int mDir = 1; bool canShoot = true;
  if (millis() < statusTimer) {
    if (playerStatus == 1) mSpeed = 0.5;
    if (playerStatus == 2) mDir = -1;
    if (playerStatus == 3) canShoot = false;
  } else { playerStatus = 0; }

  pvx += ((v_lx - 2048) / 180.0) * mSpeed * mDir;
  pvy += ((v_ly - 2048) / 180.0) * mSpeed * mDir;
  pvx *= 0.78; pvy *= 0.78;
  p.x = constrain(p.x + pvx, 10, 310); p.y = constrain(p.y + pvy, 10, 230);

  // --- 2. 進化外觀繪製 ---
  int evo = (gameLevel + 1) / 2; // 每兩關一進化
  uint16_t pCol = (millis() < invincibleTime && (millis()/100)%2==0) ? TFT_RED : TFT_SKYBLUE;
  tft.fillTriangle(p.x, p.y-14, p.x-10, p.y+10, p.x+10, p.y+10, pCol);
  if(evo >= 2) tft.drawFastHLine(p.x-15, p.y+5, 30, TFT_LIGHTGREY); // 側翼
  if(evo >= 4) tft.fillCircle(p.x, p.y, 4, TFT_WHITE); // 核心
  tft.fillRect(p.x-3, p.y+10, 6, 6, (millis()%80 > 40)? TFT_ORANGE : TFT_RED); // 動態噴火

  // --- 3. 1-10 關進化射擊與專屬音效 ---
  if (canShoot && (v_rx < 1000 || v_rx > 3000 || v_ry < 1000 || v_ry > 3000 || btn_a == HIGH)) {
    int sd = max(60, 260 - (gameLevel * 20)); // 射速隨關卡變快
    if (millis() - lastShoot > sd) {
      float bs = 5.0 + (gameLevel * 0.5);
      switch(evo) {
        case 1: playSound(3500, 40, 6); firePlayerBullet(p.x, p.y-14, 0, -bs); break;
        case 2: playSound(2800, 50, 8); firePlayerBullet(p.x-6, p.y-10, -1.0, -bs); firePlayerBullet(p.x+6, p.y-10, 1.0, -bs); break;
        case 3: playSound(2000, 60, 12); for(int i=-2; i<=2; i++) firePlayerBullet(p.x+i*5, p.y-14, i*1.3, -bs); break;
        case 4: playSound(4500, 30, 8); tft.fillRect(p.x-2, 0, 5, p.y-14, 0x5E5E); // 激光效果
                if(boss.active && abs(boss.x - p.x) < 30) boss.hp -= 2; break;
        case 5: playSound(1300, 80, 15); for(float a=-2.5; a<=2.5; a+=1.25) firePlayerBullet(p.x, p.y-16, a*1.6, -bs*1.1); 
                firePlayerBullet(p.x, p.y+12, 0, bs); // 矩陣砲與後方反擊
                break;
      }
      lastShoot = millis();
    }
  }

  // --- 4. Boss 階梯難度系統 ---
  if (fighterScore >= nextBossScore && !boss.active) {
    int hp = 60 + (gameLevel * 60); // 隨關卡線性成長的血量
    boss = {160, 45, 1.8 + (gameLevel*0.4), hp, hp, true, millis(), 0, 160, 45, bossColors[(gameLevel-1)%10]};
    nextBossScore += 80 + (gameLevel * 10);
  }

  if (boss.active) {
    long bt = millis() - boss.stateTime;
    boss.ox = boss.x; boss.oy = boss.y;
    boss.x += boss.vx; if (boss.x < 35 || boss.x > 285) boss.vx *= -1;
    tft.fillRect(boss.ox-30, boss.oy-25, 60, 55, TFT_BLACK); // 擦除舊位置

    // 第 3 關起隨機發射負面狀態彈
    int st = (gameLevel >= 3) ? (random(1, 4)) : 0; 
    if (bt % max(300, 1100 - (gameLevel*70)) < 40) {
      playSound(700, 60, 4);
      float ang = atan2(p.y - boss.y, p.x - boss.x);
      fireBossBullet(boss.x, boss.y+18, cos(ang)*3.5, sin(ang)*3.5, st);
    }
    // 繪製 Boss (含血條)
    tft.fillRoundRect(boss.x-25, boss.y-20, 50, 30, 5, boss.color);
    tft.drawRect(boss.x-20, boss.y-28, 40, 4, TFT_WHITE);
    tft.fillRect(boss.x-20, boss.y-28, 40 * ((float)boss.hp/boss.maxHp), 4, (boss.hp > boss.maxHp/2)? TFT_GREEN : TFT_RED);
  }

  // --- 5. 碰撞偵測 (子彈與 Boss) ---
  for(int i=0; i<50; i++) {
    if(!bullets[i].active) continue;
    tft.drawPixel(bullets[i].x, bullets[i].y, TFT_BLACK); // 擦除
    bullets[i].x += bullets[i].vx; bullets[i].y += bullets[i].vy;
    if(bullets[i].y < 0 || bullets[i].y > 240) bullets[i].active = false;
    else {
      tft.drawPixel(bullets[i].x, bullets[i].y, (evo>=4)? TFT_CYAN : TFT_YELLOW);
      if(boss.active && abs(bullets[i].x - boss.x) < 25 && abs(bullets[i].y - boss.y) < 20) {
        bullets[i].active = false; boss.hp--;
        if(boss.hp <= 0) {
          playSound(400, 1200, 15); triggerVibration(2, 600); 
          gameLevel++; boss.active = false; fighterScore += 200;
          playerHp = min(5, playerHp + 1); // 過關回血
          tft.fillScreen(TFT_BLACK);
          tft.drawCentreString("LEVEL CLEAR!", 160, 100, 4); delay(2000);
          if(gameLevel > 10) { gameState = 0; } tft.fillScreen(TFT_BLACK);
        }
      }
    }
  }

  // --- 6. Boss 子彈碰撞偵測 ---
  for(int i=0; i<80; i++) {
    if(!bossBullets[i].active) continue;
    tft.drawPixel(bossBullets[i].x, bossBullets[i].y, TFT_BLACK);
    bossBullets[i].x += bossBullets[i].vx; bossBullets[i].y += bossBullets[i].vy;
    if(bossBullets[i].y > 240 || bossBullets[i].x < 0 || bossBullets[i].x > 320) bossBullets[i].active = false;
    else {
      uint16_t c = (bossBullets[i].hp==1)?TFT_BLUE:(bossBullets[i].hp==2)?TFT_YELLOW:(bossBullets[i].hp==3)?TFT_GREEN:TFT_RED;
      tft.drawPixel(bossBullets[i].x, bossBullets[i].y, c);
      if(abs(bossBullets[i].x - p.x) < 10 && abs(bossBullets[i].y - p.y) < 10) {
        takeDamage(1, bossBullets[i].hp); bossBullets[i].active = false;
      }
    }
  }

  // --- 7. UI 與狀態條 ---
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawString("LV:"+String(gameLevel)+" HP:"+String(playerHp)+" PTS:"+String(fighterScore), 5, 5, 2);
  if(playerStatus > 0) {
    tft.fillRect(5, 22, (statusTimer-millis())/20, 4, TFT_YELLOW); // 負面狀態進度條
  }
  drawExitButton();
}// ==========================================
// 6. 乒乓球遊戲 (Pong) - 完整未簡化版
// ==========================================
int ballX, ballY, ballVX, ballVY;
int padL, padR, scoreL, scoreR;

void initPong() {
  ballX = 160; ballY = 120; ballVX = 3; ballVY = 2;
  padL = 100; padR = 100; scoreL = 0; scoreR = 0;
  tft.fillScreen(TFT_BLACK);
}

void playPong() {
  if (v_lz == LOW || btn_b == HIGH) { gameState = 0; delay(300); return; }
  
  // 擦除舊位置
  tft.fillRect(10, padL, 8, 40, TFT_BLACK);
  tft.fillRect(302, padR, 8, 40, TFT_BLACK);
  tft.fillCircle(ballX, ballY, 4, TFT_BLACK);

  // 控制左板 (搖桿)
  padL = constrain(padL + (v_ly - 2048) / 180, 0, 200);
  
  // 控制右板 (雙人或 AI)
  if (isMultiplayer) {
    padR = constrain(padR + (v_ry - 2048) / 180, 0, 200);
  } else {
    if (ballX > 160) {
      if (ballY > padR + 20) padR += 3; 
      else if (ballY < padR + 20) padR -= 3;
    }
  }

  // 球物理更新
  ballX += ballVX; ballY += ballVY;
  if (ballY <= 0 || ballY >= 240) { ballVY *= -1; playSound(1000, 30, 5); }
  
  // 碰撞與震動回饋
  if (ballX <= 20 && ballY >= padL && ballY <= padL + 40) { 
    ballVX *= -1.1; ballX = 22; 
    playSound(1200, 40, 10); triggerVibration(0, 50); 
  }
  if (ballX >= 300 && ballY >= padR && ballY <= padR + 40) { 
    ballVX *= -1.1; ballX = 298; 
    playSound(1200, 40, 10); triggerVibration(1, 50); 
  }

  // 得分判定
  if (ballX < 0) { scoreR++; ballX = 160; ballVX = 3; playSound(300, 200, 10); }
  if (ballX > 320) { scoreL++; ballX = 160; ballVX = -3; playSound(300, 200, 10); }

  // 繪製
  tft.fillRect(10, padL, 8, 40, TFT_WHITE);
  tft.fillRect(302, padR, 8, 40, TFT_WHITE);
  tft.fillCircle(ballX, ballY, 4, TFT_YELLOW);
  tft.setTextColor(TFT_WHITE, TFT_BLACK);
  tft.drawNumber(scoreL, 100, 10, 4); tft.drawNumber(scoreR, 200, 10, 4);
  drawExitButton();
}

