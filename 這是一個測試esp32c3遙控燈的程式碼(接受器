#include <esp_now.h>
#include <WiFi.h>
#include <esp_wifi.h>

#define LIGHT_PIN 3  // 若你目前繼電器接在 GPIO 5，請將 3 改成 5

typedef struct struct_message {
  uint8_t mode; // 0: OFF, 1: ON, 2: STROBE
} struct_message;

struct_message lightData;
volatile uint8_t currentMode = 0;

unsigned long lastFlashTime = 0;
bool flashState = false;
const int flashInterval = 80; // 爆閃間隔 (ms)

// 關鍵 High-Z (高阻抗) 開關控制函式
void setRelay(bool turnOn) {
  if (turnOn) {
    // 【開燈】強制設為 OUTPUT 並給 LOW (0V) 導通繼電器
    pinMode(LIGHT_PIN, OUTPUT);
    digitalWrite(LIGHT_PIN, LOW);
  } else {
    // 【關燈】切換為 INPUT 高阻抗，徹底切斷 3.3V 壓差造成的誤導通！
    pinMode(LIGHT_PIN, INPUT);
  }
}

void OnDataRecv(const esp_now_recv_info *info, const uint8_t *incomingData, int len) {
  if (len == sizeof(lightData)) {
    memcpy(&lightData, incomingData, sizeof(lightData));
    currentMode = lightData.mode;
    Serial.printf(">>> [收到遙控指令] 模式切換為: %d\n", currentMode);
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("=================================");
  Serial.println("車燈接收端 啟動中 ( High-Z 壓差修正版 )...");

  // 開機預設關燈：直接設為 INPUT 高阻抗，不輸出電壓
  pinMode(LIGHT_PIN, INPUT);

  WiFi.mode(WIFI_STA);
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW 初始化失敗！");
    return;
  }
  
  esp_now_register_recv_cb(OnDataRecv);
  Serial.println("ESP-NOW 就緒！等待發送端按鈕...");
  Serial.println("=================================");
}

void loop() {
  if (currentMode == 0) {
    setRelay(false); // 0: 關燈 (INPUT 高阻抗)
  } 
  else if (currentMode == 1) {
    setRelay(true);  // 1: 常亮 (OUTPUT LOW)
  } 
  else if (currentMode == 2) {
    // 2: 爆閃模式
    if (millis() - lastFlashTime > flashInterval) {
      flashState = !flashState;
      setRelay(flashState);
      lastFlashTime = millis();
    }
  }
}
