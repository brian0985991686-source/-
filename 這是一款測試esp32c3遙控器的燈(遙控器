#include <Adafruit_GFX.h>
#include <Adafruit_ST7789.h>
#include <SPI.h>
#include <esp_now.h>
#include <WiFi.h>
#include <esp_wifi.h> // 固定頻道用

// --- 賽博龐克配色 ---
#define COLOR_BG        0x0000 
#define COLOR_CYAN      0x07FF 
#define COLOR_MAGENTA   0xF81F 
#define COLOR_GREEN     0x07E0 
#define COLOR_YELLOW    0xFFE0 
#define COLOR_RED       0xF800 
#define COLOR_DARK_GRAY 0x18E3 

// --- 螢幕腳位 ---
#define TFT_CS    7   
#define TFT_DC    3
#define TFT_RST   1
#define TFT_MOSI  6   
#define TFT_SCLK  4   

// --- 按鈕腳位 (已調換為最穩定腳位) ---
#define BTN1_PIN  5   // 按鈕 1: 車燈切換
#define BTN2_PIN  10  // 按鈕 2: 碼錶啟動/暫停 (已換成實測最穩的 GPIO 10)
#define BTN3_PIN  20  // 按鈕 3: 碼錶歸零

Adafruit_ST7789 tft = Adafruit_ST7789(TFT_CS, TFT_DC, TFT_MOSI, TFT_SCLK, TFT_RST);

typedef struct struct_message {
  uint8_t mode; 
} struct_message;

struct_message lightData;
uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};

uint8_t lightMode = 0;
volatile bool linkStatus = false;        
volatile bool linkStatusChanged = true;  

bool timerRunning = false;
unsigned long timerStartTime = 0;
unsigned long elapsedTime = 0;
unsigned long lastTimerDraw = 0; 

int clockHours = 12;
int clockMinutes = 0;
int clockSeconds = 0;
unsigned long lastClockUpdate = 0;

// 按鈕前次狀態紀錄 (邊緣觸發用)
bool lastState1 = HIGH;
bool lastState2 = HIGH;
bool lastState3 = HIGH;

void drawStaticUI();
void updateLightUI();
void updateStopwatchUI(unsigned long ms);
void updateClockUI();
void updateLinkUI();

void OnDataSent(const wifi_tx_info_t *info, esp_now_send_status_t status) {
  bool currentStatus = (status == ESP_NOW_SEND_SUCCESS);
  if (linkStatus != currentStatus) {
    linkStatus = currentStatus;
    linkStatusChanged = true; 
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println(">>> 遙控發送端啟動中...");

  pinMode(BTN1_PIN, INPUT_PULLUP);
  pinMode(BTN2_PIN, INPUT_PULLUP);
  pinMode(BTN3_PIN, INPUT_PULLUP);

  tft.init(240, 320);
  tft.setRotation(1);
  tft.invertDisplay(true); 

  WiFi.mode(WIFI_STA);
  // 【關鍵】發送端也強制固定 Channel 1
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_send_cb(OnDataSent);
    
    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = 1;
    peerInfo.encrypt = false;
    esp_now_add_peer(&peerInfo);
  }

  drawStaticUI();
  updateLightUI();
  updateStopwatchUI(0);
  updateClockUI();

  // 廣播初始狀態
  lightData.mode = lightMode;
  esp_now_send(broadcastAddress, (uint8_t *)&lightData, sizeof(lightData));
  Serial.println(">>> 發送端就緒！");
}

void loop() {
  unsigned long currentMillis = millis();

  // 1. 連線狀態更新
  if (linkStatusChanged) {
    updateLinkUI();
    linkStatusChanged = false;
  }

  // 2. 時鐘更新
  if (currentMillis - lastClockUpdate >= 1000) {
    lastClockUpdate = currentMillis;
    clockSeconds++;
    if (clockSeconds >= 60) {
      clockSeconds = 0;
      clockMinutes++;
      if (clockMinutes >= 60) {
        clockMinutes = 0;
        clockHours = (clockHours + 1) % 24;
      }
    }
    updateClockUI();
  }

  // --- 3. 最直觀、100% 不卡死之按鈕偵測邏輯 ---

  // 按鈕 1 (GPIO 5 - 車燈)
  bool r1 = digitalRead(BTN1_PIN);
  if (r1 == LOW && lastState1 == HIGH) {
    delay(30); // 經典硬體去彈跳
    if (digitalRead(BTN1_PIN) == LOW) {
      Serial.println("[發送端] 按鈕 1 按下 -> 傳送車燈切換");
      lightMode = (lightMode + 1) % 3;
      lightData.mode = lightMode;
      esp_now_send(broadcastAddress, (uint8_t *)&lightData, sizeof(lightData));
      updateLightUI();
    }
  }
  lastState1 = r1;

  // 按鈕 2 (GPIO 10 - 碼錶啟動/暫停)
  bool r2 = digitalRead(BTN2_PIN);
  if (r2 == LOW && lastState2 == HIGH) {
    delay(30);
    if (digitalRead(BTN2_PIN) == LOW) {
      Serial.println("[發送端] 按鈕 2 按下 -> 碼錶切換");
      if (timerRunning) {
        elapsedTime += (currentMillis - timerStartTime);
        timerRunning = false;
      } else {
        timerStartTime = currentMillis;
        timerRunning = true;
      }
      updateStopwatchUI(timerRunning ? elapsedTime + (currentMillis - timerStartTime) : elapsedTime);
    }
  }
  lastState2 = r2;

  // 按鈕 3 (GPIO 20 - 碼錶歸零)
  bool r3 = digitalRead(BTN3_PIN);
  if (r3 == LOW && lastState3 == HIGH) {
    delay(30);
    if (digitalRead(BTN3_PIN) == LOW) {
      Serial.println("[發送端] 按鈕 3 按下 -> 碼錶歸零");
      timerRunning = false;
      elapsedTime = 0;
      updateStopwatchUI(0);
    }
  }
  lastState3 = r3;

  // 4. 碼錶繪畫刷新 (50ms)
  if (timerRunning && (currentMillis - lastTimerDraw >= 50)) {
    lastTimerDraw = currentMillis;
    unsigned long total = elapsedTime + (currentMillis - timerStartTime);
    updateStopwatchUI(total);
  }
}

// --- UI 繪製邏輯 ---
void drawStaticUI() {
  tft.fillScreen(COLOR_BG);
  tft.drawRect(2, 2, 316, 236, COLOR_DARK_GRAY);
  tft.drawRect(4, 4, 312, 232, COLOR_CYAN);

  tft.fillRect(4, 4, 312, 28, COLOR_DARK_GRAY);
  tft.setTextColor(COLOR_CYAN);
  tft.setTextSize(2);
  tft.setCursor(12, 10);
  tft.print("CYBER-BIKE // v2");
  tft.drawFastHLine(4, 32, 312, COLOR_CYAN);

  tft.drawRoundRect(10, 40, 300, 85, 6, COLOR_DARK_GRAY);
  tft.setCursor(20, 46);
  tft.setTextSize(1);
  tft.setTextColor(COLOR_CYAN);
  tft.print("[ LIGHT SYSTEM CONTROL ]");

  tft.drawRoundRect(10, 132, 300, 95, 6, COLOR_DARK_GRAY);
  tft.setCursor(20, 138);
  tft.setTextSize(1);
  tft.setTextColor(COLOR_CYAN);
  tft.print("[ CHRONO METRIC / STOPWATCH ]");
}

void updateLinkUI() {
  tft.fillRect(235, 210, 75, 15, COLOR_BG);
  tft.setTextSize(1);
  tft.setCursor(240, 212);
  
  if (linkStatus) {
    tft.fillCircle(298, 215, 3, COLOR_GREEN);
    tft.setTextColor(COLOR_GREEN);
    tft.print("LINK OK");
  } else {
    tft.fillCircle(298, 215, 3, COLOR_RED);
    tft.setTextColor(COLOR_RED);
    tft.print("LINK FAIL");
  }
}

void updateLightUI() {
  tft.fillRect(15, 62, 290, 58, COLOR_BG); 
  tft.setTextSize(3);

  if (lightMode == 0) {
    tft.fillRoundRect(20, 70, 85, 42, 4, COLOR_DARK_GRAY);
    tft.drawRoundRect(20, 70, 85, 42, 4, COLOR_RED);
    tft.setTextColor(COLOR_RED);
    tft.setCursor(40, 81);
    tft.print("OFF");

    tft.setTextColor(COLOR_DARK_GRAY);
    tft.setCursor(120, 81);
    tft.print("STANDBY");
  } else if (lightMode == 1) {
    tft.fillRoundRect(20, 70, 85, 42, 4, COLOR_GREEN);
    tft.setTextColor(COLOR_BG);
    tft.setCursor(45, 81);
    tft.print("ON");

    tft.setTextColor(COLOR_GREEN);
    tft.setCursor(120, 81);
    tft.print("BEAM ACTIVE");
  } else if (lightMode == 2) {
    tft.fillRoundRect(20, 70, 85, 42, 4, COLOR_MAGENTA);
    tft.setTextColor(COLOR_BG);
    tft.setCursor(25, 81);
    tft.print("FLASH");

    tft.setTextColor(COLOR_MAGENTA);
    tft.setCursor(120, 81);
    tft.print("STROBE WARN");
  }
}

void updateClockUI() {
  tft.fillRect(215, 8, 95, 20, COLOR_DARK_GRAY);
  tft.setTextSize(2);
  tft.setTextColor(COLOR_YELLOW);
  tft.setCursor(218, 10);

  char buf[9];
  sprintf(buf, "%02d:%02d:%02d", clockHours, clockMinutes, clockSeconds);
  tft.print(buf);
}

void updateStopwatchUI(unsigned long ms) {
  int seconds = (ms / 1000) % 60;
  int minutes = (ms / (1000 * 60)) % 60;
  int tenths = (ms / 100) % 10;

  char buf[12];
  sprintf(buf, "%02d:%02d.%d", minutes, seconds, tenths);

  tft.fillRect(25, 158, 240, 48, COLOR_BG); 
  tft.setTextSize(4);
  tft.setTextColor(COLOR_CYAN);
  tft.setCursor(25, 163);
  tft.print(buf);

  tft.fillRect(225, 138, 80, 15, COLOR_BG);
  tft.setTextSize(1);
  if (timerRunning) {
    tft.setTextColor(COLOR_GREEN);
    tft.setCursor(225, 138);
    tft.print("> RUNNING");
  } else {
    tft.setTextColor(COLOR_YELLOW);
    tft.setCursor(225, 138);
    tft.print("# PAUSED");
  }
}
